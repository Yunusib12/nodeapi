<%#
  footer.ejs — the BOTTOM half of every page (shared layout).

  Closes the <main> container opened in head.ejs, shows the page footer,
  the shared confirmation modal, and loads the only client-side script.
%>
    </main>
    <footer class="text-center text-muted py-4 border-top mt-5">
      <small>Node Employee API &middot; built with Express &amp; EJS</small>
    </footer>

    <%#
      Shared confirmation modal. It replaces the browser's native
      window.confirm() dialog. It uses Bootstrap's modal CSS classes but
      is shown/hidden by app.js (no jQuery / Bootstrap JS needed).
    %>
    <div class="modal fade" id="confirmModal" tabindex="-1" role="dialog"
         aria-labelledby="confirmModalTitle" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="confirmModalTitle">Please confirm</h5>
            <button type="button" class="close" data-modal-dismiss aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <p id="confirmModalMessage" class="mb-0"></p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-modal-dismiss>Cancel</button>
            <button type="button" class="btn btn-danger" id="confirmModalOk">Confirm</button>
          </div>
        </div>
      </div>
    </div>

    <script src="/assets/js/app.js"></script>
  </body>
</html>

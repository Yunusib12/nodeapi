<%#
  employeedetail.ejs — one employee plus their project(s).
  Rendered by getEmployeeData for GET "/api/employee/:id".

  Expects:
    emplDetArr     - array containing the single employee
    emplProArr     - array of that employee's project(s) (0 or 1)
    isDetailNeeded - when true, show the Projects panel
%>
<% const emp = emplDetArr[0]; %>
<%- include('head', { title: emp ? emp.name : 'Employee Detail' }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb bg-white shadow-sm">
    <li class="breadcrumb-item"><a href="/">Employees</a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= emp ? emp.name : 'Detail' %></li>
  </ol>
</nav>

<div class="row">
  <div class="col-lg-4 mb-4">
    <% emplDetArr.forEach((employee)=>{ %>
    <div class="card h-100 shadow-sm">
      <div class="card-header"><h3 class="mb-0"><%= employee.name %></h3></div>
      <div class="card-body d-flex align-items-center justify-content-center">
        <img
          class="img-fluid rounded"
          style="max-height: 240px; object-fit: contain;"
          src="<%= employee.avatar %>"
          alt="<%= employee.name %>"
        />
      </div>
      <div class="card-footer bg-white d-flex">
        <a class="btn btn-sm btn-outline-secondary mr-2" href="/api/employee/<%= employee.id %>/edit">Edit</a>
        <form
          action="/api/employee/<%= employee.id %>/delete"
          method="POST"
          class="ml-auto"
          data-confirm="Delete <%= employee.name %>?"
        >
          <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
        </form>
      </div>
    </div>
    <% }); %>
  </div>

  <% if (isDetailNeeded == true) { %>
  <div class="col-lg-8 mb-4">
    <div class="card border-secondary h-100 shadow-sm">
      <div class="card-header"><h4 class="mb-0">Projects</h4></div>
      <div class="card-body">
        <% if (emplProArr.length > 0) { emplProArr.forEach((employeeP)=> { %>
        <h5 class="card-title text-primary"><%= employeeP.name %></h5>
        <p class="card-text"><%= employeeP.Detail %></p>
        <% }); } else { %>
        <p class="text-muted mb-0">No project assigned.</p>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>
</div>

<a href="/" class="btn btn-link pl-0">&larr; Back to Employees</a>

<%- include('footer') %>
